{
  "name": "pi-unified-exec",
  "version": "0.13.1",
  "private": true,
  "description": "Reusable shell sessions for Pi with interactive input, polling, and output recovery.",
  "keywords": [
    "pi-package",
    "pi-extension",
    "codex",
    "unified-exec",
    "bash",
    "pty"
  ],
  "license": "MIT",
  "author": "Ren Wang",
  "contributors": [
    "kokoro11 (https://github.com/kokoro11)"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kokoro11/pi-unified-exec.git"
  },
  "homepage": "https://github.com/kokoro11/pi-unified-exec#readme",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "check": "tsc --noEmit",
    "test": "tsc --noEmit && bun test --parallel=2 --timeout 30000",
    "test:tui": "bun test tui-"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.99.1",
    "@earendil-works/pi-tui": ">=0.99.1",
    "typebox": "*"
  },
  "dependencies": {
    "@homebridge/node-pty-prebuilt-multiarch": "0.15.0",
    "@seydx/win-job": "0.1.0",
    "@xterm/headless": "6.0.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.0.0",
    "@earendil-works/pi-tui": "1.0.0",
    "@types/bun": "1.4.4",
    "@types/node": "^22.0.0",
    "typebox": "1.3.27",
    "typescript": "^5.6.0"
  },
  "trustedDependencies": [
    "@homebridge/node-pty-prebuilt-multiarch"
  ]
}
