{
  "name": "pi-unified-exec",
  "version": "0.13.1",
  "description": "Codex-style unified_exec for pi: long-lived shell sessions the LLM polls and drives with write_stdin (Ctrl-C, arrow keys, PTY, REPLs, ssh, dev servers). Full output logged to disk.",
  "keywords": [
    "pi-package",
    "pi-extension",
    "codex",
    "unified-exec",
    "bash",
    "pty"
  ],
  "license": "MIT",
  "author": "Ren Wang <iamwrm@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iamwrm/pi-unified-exec.git"
  },
  "homepage": "https://github.com/iamwrm/pi-unified-exec#readme",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "check": "tsc --noEmit",
    "test": "tsc --noEmit && bun test --timeout 30000",
    "test:tui": "bun test tui-"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.99.1",
    "@earendil-works/pi-tui": ">=0.99.1",
    "typebox": "*"
  },
  "dependencies": {
    "@homebridge/node-pty-prebuilt-multiarch": "0.15.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.0.0",
    "@earendil-works/pi-tui": "1.0.0",
    "@types/bun": "1.4.4",
    "@types/node": "^22.0.0",
    "typebox": "1.3.27",
    "typescript": "^5.6.0"
  },
  "trustedDependencies": [
    "@homebridge/node-pty-prebuilt-multiarch"
  ]
}
